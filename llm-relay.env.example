# Copy to ~/.claude/llm-relay.env and fill in. Never commit this file.
LLM_BASE=https://your-relay.example.com
LLM_KEY=sk-...
LLM_MODEL=gpt-6-astra
LLM_REASONING=xhigh
# Some relays reject requests below a minimum input size; llm.mjs pads short prompts up to this many tokens. 0 = off.
LLM_MIN_INPUT_TOKENS=0
