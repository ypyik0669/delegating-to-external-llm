# Copy to ~/.claude/llm-relay.env and fill in. Never commit this file.
LLM_BASE=https://your-relay.example.com
LLM_KEY=sk-...
LLM_MODEL=gpt-6-astra
LLM_REASONING=xhigh
# Some relays reject requests below a minimum input size; llm.mjs pads short prompts up to this many tokens. 0 = off.
LLM_MIN_INPUT_TOKENS=0
# codex permission level for the agentic lane:
#   workspace      write only inside the repo, no network (safe default)
#   workspace-net  repo + network (npm install etc.)
#   yolo           no sandbox, no approval prompts — the model can do anything your account can
LLM_CODEX_ACCESS=workspace
# Optional USD per 1M tokens, for the ledger's cost lines (0 = not priced)
LLM_PRICE_IN=0
LLM_PRICE_CACHED=0
LLM_PRICE_OUT=0
CLAUDE_PRICE_IN=0
CLAUDE_PRICE_OUT=0
